# ============================================================
# NFT MINT SNIPER BOT (v3.0 CLI) — ENVIRONMENT CONFIGURATION
# ============================================================

# ─── OPENSEA ENDPOINTS (Pre-configured - Do not change) ───
OPENSEA_GQL_URL=https://gql.opensea.io/graphql/
OPENSEA_AUTH_URL=https://auth.opensea.io
X_APP_ID=os2-web

# ─── YOUR RPC KEYS ───
# Alchemy API Key (Auto-expands for Ethereum, Base, Arbitrum, Optimism):
# Get a free key at: https://alchemy.com
ALCHEMY_KEY=your_alchemy_key_here

# Ankr Backup RPC Key (Optional):
ANKR_KEY=your_ankr_key_here

# Etherscan Key (Optional):
ETHERSCAN_KEY=your_etherscan_key_here

# ─── DEFAULT CHAIN & RPC ───
DEFAULT_CHAIN=ETHEREUM
DEFAULT_RPC_URL=https://eth.llamarpc.com

# ─── DEFAULT GAS SETTINGS ───
DEFAULT_GAS_LIMIT=300000
DEFAULT_MAX_FEE_GWEI=25.0
DEFAULT_PRIORITY_FEE_GWEI=1.5

# ─── DEFAULT RECIPIENT (Optional) ───
# Forward all minted NFTs to this address if specified:
RECIPIENT_ADDRESS=

# ─── ALERTS & NOTIFICATIONS (Optional) ───
# Discord: Webhook URL (e.g. https://discord.com/api/webhooks/...)
DISCORD_WEBHOOK_URL=

# Telegram: Bot Token and numeric Chat ID
# Create bot via @BotFather, get Chat ID via @userinfobot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
