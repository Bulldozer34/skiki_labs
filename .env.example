# ============================================================
# NFT MINT SNIPER BOT (v3.0 CLI) — ENVIRONMENT CONFIGURATION
# ============================================================
#
# INSTRUCTIONS FOR BEGINNERS:
# 1. Copy this file and rename the copy to: .env
# 2. Open .env in Notepad, VS Code, or any text editor.
# 3. Fill in any optional settings below that you wish to use.
# 4. Save the file. (Never share your .env file with anyone!)
#
# NOTE: All settings in this file are OPTIONAL. The bot has built-in
# smart defaults and can run even without an Alchemy key.
# ============================================================

# ─── OPENSEA ENDPOINTS (Pre-configured — Do not modify) ───────
OPENSEA_GQL_URL=https://gql.opensea.io/graphql/
OPENSEA_AUTH_URL=https://auth.opensea.io
OPENSEA_API_URL=https://api.opensea.io
X_APP_ID=os2-web

# ─── OPENSEA API KEYS (Optional - supports multi-key rotation) ───
# Paste your primary and backup/secondary OpenSea API keys here for auto-rotation:
OPENSEA_API_KEY=
OPENSEA_API_KEY_2=

# ─── YOUR RPC PROVIDER KEYS (Recommended for Maximum Speed) ───
# Alchemy API Key (Auto-expands for Ethereum, Robinhood, Base, Arbitrum, Optimism):
# Get a free key in 1 minute at: https://alchemy.com
# Example: ALCHEMY_KEY=abc123xyz456_myAlchemyKey
ALCHEMY_KEY=

# QuickNode Endpoint for Multi-RPC Racing & Vital Mints (Optional):
# Free PAYG tier gives 10M free credits/month (Get at: https://www.quicknode.com)
QUICKNODE_URL=
# For hyped Robinhood mints, keep this false so QuickNode races in the first
# broadcast wave alongside the direct sequencer ingress.
USE_QUICKNODE_ONLY_FOR_VITAL_MINTS=false

SECONDARY_RPC_URL=

# Ankr Backup RPC Key (Optional — used for Ethereum mainnet racing):
# Get a free key at: https://www.ankr.com/rpc/
ANKR_KEY=

# Etherscan & Blockscout API Keys (Optional):
ETHERSCAN_KEY=
BLOCKSCOUT_API_KEY=

# ─── WEBSOCKET PUSH CHANNEL (Optional, but big speed win) ─────
# A WebSocket connection receives block/receipt updates by push instead of
# polling, which removes up to ~40ms of confirmation latency.
#
# The bot enables this automatically for Alchemy, QuickNode, Infura and
# PublicNode endpoints. It CANNOT be auto-enabled for the public Robinhood,
# Base, Arbitrum or Optimism RPCs — those sit behind a CDN that refuses the
# WebSocket upgrade. To get a real WebSocket on those chains, either set
# ALCHEMY_KEY above (the bot then talks to Alchemy over wss automatically),
# or paste an explicit WebSocket URL here:
RPC_WS_URL=

# Advanced: rewrite any https:// RPC to wss:// even when the provider is not
# known to support it. Leave empty unless you have tested that your endpoint
# answers a WebSocket upgrade — a wrong guess just means no push channel.
RPC_WS_GUESS=

# ─── SNIPER TIMING & PULSE ENGINE ────────────────────────────
# Robinhood Chain is FIFO: arrival time at the sequencer decides queue position.
# Leave SNIPER_LEAD_TIME_MS empty on Render Ohio so the bot measures direct
# sequencer vs QuickNode vs private RPC at T-5s and calibrates from the fastest
# live write path. Set a number only if you have measured your own path.
SNIPER_LEAD_TIME_MS=

# Keep Robinhood direct sequencer ingress and Nitro feed enabled unless debugging.
SNIPER_USE_SEQUENCER=1
SNIPER_USE_FEED=1

# Tight duplicate pulses for packet-loss insurance. Longer tails usually land
# after the FIFO race is already decided and spend rate limit.
SNIPER_BURST_OFFSETS=0,40,90

# Receipt polling fallback cadence when the sequencer feed or WebSocket is not live.
SNIPER_RECEIPT_POLL_MS=250

# The sniper raises its own OS scheduler priority for the countdown, because the
# biggest source of timer jitter is the OS handing our CPU core to another
# process. Measured on Windows under load, this cut the worst-case trigger error
# from ~530ms to under 1ms. It asks for HIGH (never REALTIME), and silently
# carries on if refused — a negative nice value needs root or CAP_SYS_NICE on
# Linux, so on a VPS either run as root or accept a few ms of jitter.
# Set to 0 to leave process priority alone.
SNIPER_PRIORITY_BOOST=1

# ─── DEFAULT CHAIN & RPC ─────────────────────────────────────
# Fallback network and RPC if no specific chain is chosen:
DEFAULT_CHAIN=ETHEREUM
DEFAULT_RPC_URL=https://eth.llamarpc.com

# ─── DEFAULT GAS SETTINGS ────────────────────────────────────
# You can customize default gas limits and fees here.
# (Note: For L2 chains like Base/Arbitrum, the bot automatically optimizes gas)
DEFAULT_GAS_LIMIT=300000
DEFAULT_MAX_FEE_GWEI=25.0
DEFAULT_PRIORITY_FEE_GWEI=1.5

# ─── DEFAULT RECIPIENT FORWARDING (Optional) ─────────────────
# If set, minted NFTs will be automatically transferred from your
# minting wallets to this safe cold storage address:
RECIPIENT_ADDRESS=

# ─── ALERTS & NOTIFICATIONS (Optional) ────────────────────────
# Discord Webhook URL for instant mint notifications:
# (Server Settings -> Integrations -> Webhooks -> Create Webhook)
DISCORD_WEBHOOK_URL=

# Telegram Bot Notifications:
# 1. Create a bot using @BotFather on Telegram to get your TELEGRAM_BOT_TOKEN
# 2. Message @userinfobot on Telegram to get your numeric TELEGRAM_CHAT_ID
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ─── RISK & BUDGET MANAGEMENT (v4 Ecosystem) ─────────────────
# Maximum unit price in USD allowed per NFT before requiring manual confirmation
RISK_MAX_PRICE_USD=0.50

# Maximum total daily spending budget in USD across all wallets (resets 00:00 UTC)
RISK_DAILY_BUDGET_USD=15.00

# Maximum number of NFTs allowed to be bought from a single collection per day
RISK_MAX_PER_COLLECTION=1

# Maximum allowed slippage percentage on secondary marketplace sweeps
RISK_MAX_SLIPPAGE_PCT=10

# Take-profit target percentage for auto-listing (e.g., 50 for +50% markup)
RISK_TAKE_PROFIT_PCT=50

# Stop-loss threshold percentage (e.g., 25 for selling on 25% floor drawdown)
RISK_STOP_LOSS_PCT=25

# ─── COPY-MINT & WHALE TRACKER ENGINE ─────────────────────────
# WebSocket RPC endpoint for sub-second mempool pending transaction streaming
# Example: wss://eth-mainnet.g.alchemy.com/v2/YOUR_KEY or wss://feed.mainnet.chain.robinhood.com
WS_RPC_URL=

# Enable mempool pending transaction detection (true = fastest sub-second copy-mint)
ENABLE_PENDING_DETECTION=true

# Enable 24/7 background autominting when running daemon
AUTOMINT_ENABLED=true

# Maximum ETH price ceiling allowed per copy-mint (protects against draining/overpriced traps)
MAX_MINT_ETH=0.05

# Allow copying unknown function selectors (false = only copy known NFT mint signatures)
COPY_UNKNOWN_MINT_CALLS=false

# Automatically forward copy-minted NFTs to RECIPIENT_ADDRESS
AUTO_FORWARD_COPY_MINTS=true

# Default quantity to mint per wallet for copy-mints
DEFAULT_MINT_QUANTITY=1

# Wallet numbers for PAID drops (e.g. 1, 3, 7 or 1-5 or all; free drops always use all wallets)
PAID_WALLET_NUMBERS=1-5

# Default gas mode for copy-mints (RAPID, INSTANT, AGGRESSIVE, ULTRA, STANDARD)
DEFAULT_GAS_MODE=RAPID

# Minimum items a whale must buy from a collection to trigger conviction copy-buy
RISK_WHALE_CONVICTION=2

